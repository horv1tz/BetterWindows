<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>BetterWindows.Native</RootNamespace>
    <AssemblyName>BetterWindows.Windows</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Data.OleDb" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <!-- status stream: WMI brightness (System.Management) and SystemEvents.UserPreferenceChanged for theme/animation settings.
       VersionOverride is used because Directory.Packages.props is a frozen contract file (see contractRequests: add the two PackageVersion lines there). -->
  <ItemGroup>
    <PackageReference Include="System.Management" VersionOverride="8.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" VersionOverride="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BetterWindows.Core\BetterWindows.Core.csproj" />
    <InternalsVisibleTo Include="BetterWindows.Windows.Tests" />
  </ItemGroup>
</Project>
