{
  "domain": "desktop",
  "types": {
    "DesktopIcon": {
      "id": {
        "type": "string",
        "doc": "'sc:<guid>' (user shortcut), 'fs:<lower-cased path>' (desktop folder item), 'special:thisPc' | 'special:recycleBin'."
      },
      "name": "string",
      "iconUrl": "string",
      "x": {
        "type": "int",
        "doc": "Grid column."
      },
      "y": {
        "type": "int",
        "doc": "Grid row."
      },
      "target": "string",
      "kind": {
        "type": "DesktopIconKind",
        "default": "shortcut"
      }
    },
    "DesktopState": {
      "enabled": "bool",
      "wallpaperUrl": "string?",
      "wallpaperFit": "WallpaperFit",
      "iconSize": "int",
      "icons": "DesktopIcon[]",
      "widgets": "WidgetInstance[]",
      "monitorId": {
        "type": "string",
        "doc": "The monitor this surface instance renders."
      }
    },
    "IdParams": {
      "id": "string"
    },
    "DesktopMoveParams": {
      "id": "string",
      "x": "int",
      "y": "int"
    },
    "AddShortcutParams": {
      "path": "string",
      "x": "int?",
      "y": "int?",
      "monitorId": "string?"
    },
    "SetWallpaperParams": {
      "path": "string",
      "monitorId": {
        "type": "string?",
        "doc": "null = all monitors."
      }
    },
    "MoveWidgetParams": {
      "id": "string",
      "x": "double",
      "y": "double"
    },
    "AddWidgetParams": {
      "type": "WidgetType",
      "size": "WidgetSize?",
      "x": {
        "type": "double?",
        "doc": "Absent: the host cascades at (48+24n, 80+24n) DIP on the target monitor."
      },
      "y": "double?",
      "monitorId": "string?"
    },
    "UpdateWidgetParams": {
      "id": "string",
      "size": "WidgetSize?",
      "config": {
        "type": "any",
        "doc": "When present, REPLACES the widget's whole config object (not merged); absent = unchanged."
      }
    },
    "WeatherHour": {
      "time": "string",
      "tempC": "double",
      "code": "int"
    },
    "WeatherDay": {
      "date": "string",
      "highC": "double",
      "lowC": "double",
      "code": "int"
    },
    "WeatherSnapshot": {
      "available": "bool",
      "error": "string?",
      "location": "string",
      "tempC": "double",
      "apparentC": "double",
      "code": {
        "type": "int",
        "doc": "WMO weather code."
      },
      "isDay": {
        "type": "bool",
        "default": true
      },
      "humidity": "int?",
      "windKph": "double?",
      "hourly": "WeatherHour[]",
      "daily": "WeatherDay[]",
      "updatedAt": "string?"
    },
    "WeatherGetParams": {
      "force": {
        "type": "bool",
        "default": false
      }
    },
    "WeatherLocation": {
      "name": "string",
      "country": "string?",
      "admin": "string?",
      "latitude": "double",
      "longitude": "double"
    },
    "WeatherSearchParams": {
      "query": "string"
    },
    "WeatherLocations": {
      "locations": "WeatherLocation[]"
    },
    "Reminder": {
      "id": "string",
      "title": "string",
      "notes": "string?",
      "due": {
        "type": "string?",
        "doc": "ISO-8601 local date-time."
      },
      "done": "bool",
      "list": "string?"
    },
    "ReminderList": {
      "items": "Reminder[]"
    },
    "ReminderAddParams": {
      "title": "string",
      "due": "string?",
      "notes": "string?",
      "list": "string?"
    },
    "ReminderUpdateParams": {
      "id": "string",
      "title": "string?",
      "due": {
        "type": "string?",
        "doc": "absent = unchanged; empty string = clear the field."
      },
      "notes": {
        "type": "string?",
        "doc": "absent = unchanged; empty string = clear the field."
      },
      "done": "bool?",
      "list": {
        "type": "string?",
        "doc": "absent = unchanged; empty string = clear the field."
      }
    }
  },
  "events": {
    "desktop.state": {
      "dir": "host",
      "payload": "DesktopState",
      "state": true,
      "initial": [
        "desktop"
      ]
    },
    "reminders.changed": {
      "dir": "host",
      "payload": "ReminderList",
      "state": true,
      "initial": [
        "overlay",
        "desktop"
      ]
    },
    "reminders.due": {
      "dir": "host",
      "payload": "Reminder",
      "doc": "A reminder's due time passed (fires once)."
    }
  },
  "calls": {
    "desktop.moveIcon": {
      "params": "DesktopMoveParams",
      "result": null,
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "desktop.open": {
      "params": "IdParams",
      "result": null,
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "desktop.addShortcut": {
      "params": "AddShortcutParams",
      "result": "DesktopIcon",
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "desktop.removeShortcut": {
      "params": "IdParams",
      "result": null,
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "desktop.setWallpaper": {
      "params": "SetWallpaperParams",
      "result": null,
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "desktop.moveWidget": {
      "params": "MoveWidgetParams",
      "result": null,
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "desktop.addWidget": {
      "params": "AddWidgetParams",
      "result": "WidgetInstance",
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "desktop.removeWidget": {
      "params": "IdParams",
      "result": null,
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "desktop.updateWidget": {
      "params": "UpdateWidgetParams",
      "result": "WidgetInstance",
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "weather.get": {
      "params": "WeatherGetParams",
      "result": "WeatherSnapshot",
      "surfaces": [
        "desktop",
        "overlay",
        "settings"
      ]
    },
    "weather.search": {
      "params": "WeatherSearchParams",
      "result": "WeatherLocations",
      "surfaces": [
        "settings"
      ]
    },
    "weather.setLocation": {
      "params": "WeatherLocation",
      "result": null,
      "surfaces": [
        "settings"
      ]
    },
    "reminders.list": {
      "params": null,
      "result": "ReminderList",
      "surfaces": [
        "desktop",
        "overlay"
      ]
    },
    "reminders.add": {
      "params": "ReminderAddParams",
      "result": "Reminder",
      "surfaces": [
        "desktop",
        "overlay"
      ]
    },
    "reminders.update": {
      "params": "ReminderUpdateParams",
      "result": "Reminder",
      "surfaces": [
        "desktop",
        "overlay"
      ]
    },
    "reminders.remove": {
      "params": "IdParams",
      "result": null,
      "surfaces": [
        "desktop",
        "overlay"
      ]
    }
  },
  "enums": {
    "DesktopIconKind": [
      "shortcut",
      "file",
      "folder",
      "special"
    ]
  }
}