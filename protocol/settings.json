{
  "domain": "settings",
  "enums": {
    "DockPosition": [
      "bottom",
      "left",
      "right"
    ],
    "DockMonitor": [
      "primary",
      "all"
    ],
    "PinnedKind": [
      "app",
      "folder"
    ],
    "TaskbarMode": {
      "values": [
        "hidden",
        "autoHide",
        "visible"
      ],
      "doc": "What happens to the native Windows taskbar."
    },
    "HotCornerAction": [
      "none",
      "missionControl",
      "launchpad",
      "spotlight",
      "showDesktop",
      "lockScreen",
      "sleep"
    ],
    "WallpaperFit": [
      "fill",
      "fit",
      "stretch",
      "center",
      "tile"
    ],
    "WidgetType": [
      "clock",
      "calendar",
      "weather",
      "reminders",
      "media",
      "battery",
      "notes"
    ],
    "WidgetSize": [
      "small",
      "medium",
      "large"
    ],
    "TemperatureUnit": [
      "c",
      "f"
    ]
  },
  "types": {
    "AppearanceSettings": {
      "mode": {
        "type": "ThemePreference",
        "default": "auto"
      },
      "accent": {
        "type": "string",
        "default": "system",
        "doc": "'system' or a CSS hex colour."
      },
      "reduceTransparency": "bool",
      "reduceMotion": "bool"
    },
    "PinnedItem": {
      "id": {
        "type": "string",
        "doc": "Stable id: 'aumid:<AUMID>' | 'exe:<lowercased full path>' | 'dir:<full path>'."
      },
      "kind": "PinnedKind",
      "target": {
        "type": "string",
        "doc": "AUMID, exe path or folder path."
      },
      "name": "string?"
    },
    "DockSettings": {
      "enabled": {
        "type": "bool",
        "default": true
      },
      "position": {
        "type": "DockPosition",
        "default": "bottom"
      },
      "iconSize": {
        "type": "int",
        "default": 56,
        "doc": "DIP, clamped 32..128."
      },
      "magnification": {
        "type": "bool",
        "default": true
      },
      "magnifiedSize": {
        "type": "int",
        "default": 88,
        "doc": "DIP, clamped to iconSize..192."
      },
      "autoHide": {
        "type": "bool",
        "default": false
      },
      "reserveSpace": {
        "type": "bool",
        "default": true,
        "doc": "Register as AppBar so maximised windows stop above the dock. Ignored when autoHide."
      },
      "showIndicators": {
        "type": "bool",
        "default": true
      },
      "bounceOnLaunch": {
        "type": "bool",
        "default": true
      },
      "monitor": {
        "type": "DockMonitor",
        "default": "primary"
      },
      "pins": "PinnedItem[]"
    },
    "MenuBarSettings": {
      "enabled": {
        "type": "bool",
        "default": true
      },
      "showDate": {
        "type": "bool",
        "default": true
      },
      "showSeconds": {
        "type": "bool",
        "default": false
      },
      "use24Hour": {
        "type": "bool",
        "default": true
      },
      "showBatteryPercent": {
        "type": "bool",
        "default": true
      },
      "autoHide": {
        "type": "bool",
        "default": false
      },
      "translucent": {
        "type": "bool",
        "default": true
      },
      "allMonitors": {
        "type": "bool",
        "default": true
      }
    },
    "SpotlightSettings": {
      "hotkey": {
        "type": "string",
        "default": "Alt+Space"
      },
      "providers": {
        "type": "string[]",
        "default": [
          "apps",
          "calc",
          "settings",
          "commands",
          "windows",
          "files",
          "web"
        ]
      },
      "webSearchUrl": {
        "type": "string",
        "default": "https://duckduckgo.com/?q={query}"
      },
      "maxResults": {
        "type": "int",
        "default": 9
      }
    },
    "HotkeySettings": {
      "launchpad": {
        "type": "string",
        "default": "Ctrl+Alt+L"
      },
      "missionControl": {
        "type": "string",
        "default": "Ctrl+Alt+M"
      },
      "exit": {
        "type": "string",
        "default": "Ctrl+Alt+Q"
      },
      "toggleTaskbar": {
        "type": "string",
        "default": "Ctrl+Alt+Shift+T"
      }
    },
    "HotCornerSettings": {
      "enabled": {
        "type": "bool",
        "default": true
      },
      "topLeft": {
        "type": "HotCornerAction",
        "default": "missionControl"
      },
      "topRight": {
        "type": "HotCornerAction",
        "default": "none"
      },
      "bottomLeft": {
        "type": "HotCornerAction",
        "default": "none"
      },
      "bottomRight": {
        "type": "HotCornerAction",
        "default": "none"
      },
      "dwellMs": {
        "type": "int",
        "default": 150
      }
    },
    "TaskbarSettings": {
      "mode": {
        "type": "TaskbarMode",
        "default": "hidden"
      }
    },
    "DesktopShortcut": {
      "id": "string",
      "name": "string",
      "target": "string",
      "x": "int",
      "y": "int",
      "monitorId": {
        "type": "string?",
        "doc": "null = primary monitor."
      }
    },
    "WidgetInstance": {
      "id": "string",
      "type": "WidgetType",
      "size": {
        "type": "WidgetSize",
        "default": "medium"
      },
      "x": "double",
      "y": "double",
      "config": {
        "type": "any",
        "doc": "Widget-specific JSON object. desktop.updateWidget REPLACES the whole object. Schemas: clock {style:'digital'|'analog', seconds:bool, timezone?:string}; calendar {weekNumbers:bool}; weather {} (uses settings.weather); reminders {list?:string}; media {}; battery {}; notes {text:string}."
      },
      "monitorId": {
        "type": "string?",
        "doc": "null = primary monitor."
      }
    },
    "DesktopSettings": {
      "enabled": {
        "type": "bool",
        "default": false,
        "doc": "Replace the desktop layer (wallpaper, shortcuts, widgets). Off until the user opts in."
      },
      "hideNativeIcons": {
        "type": "bool",
        "default": true
      },
      "wallpaperPath": "string?",
      "wallpaperFit": {
        "type": "WallpaperFit",
        "default": "fill"
      },
      "iconSize": {
        "type": "int",
        "default": 64
      },
      "gridSnap": {
        "type": "bool",
        "default": true
      },
      "shortcuts": "DesktopShortcut[]",
      "widgets": "WidgetInstance[]",
      "wallpapers": {
        "type": "map<string>",
        "doc": "monitorId -> wallpaper path; overrides wallpaperPath, which is the default for monitors without an entry."
      },
      "showDesktopFolder": {
        "type": "bool",
        "default": true,
        "doc": "Also show the contents of the user's Desktop folder (+ This PC, Recycle Bin) as icons; otherwise only 'shortcuts'. With hideNativeIcons on, turning this off makes those items unreachable from the desktop."
      },
      "placements": {
        "type": "map<DesktopCell>",
        "doc": "Icon id -> grid cell for icons that are not in 'shortcuts' (desktop-folder items, specials)."
      }
    },
    "WeatherSettings": {
      "locationName": "string",
      "latitude": "double?",
      "longitude": "double?",
      "unit": {
        "type": "TemperatureUnit",
        "default": "c"
      }
    },
    "LaunchpadFolder": {
      "id": {
        "type": "string",
        "doc": "'folder:<guid>'."
      },
      "name": "string",
      "appIds": {
        "type": "string[]",
        "doc": "App ids in in-folder order."
      }
    },
    "LaunchpadSettings": {
      "folders": "LaunchpadFolder[]",
      "order": {
        "type": "string[]",
        "doc": "Top-level grid order: app ids AND folder ids. Apps that are members of a folder or listed in 'hidden' MUST NOT appear here. Apps missing from 'order' are appended alphabetically. Ids of uninstalled apps are pruned on save, folder ids are kept."
      },
      "hidden": "string[]"
    },
    "GeneralSettings": {
      "autostart": {
        "type": "bool",
        "default": false
      },
      "language": {
        "type": "string",
        "default": "auto",
        "doc": "'auto' | 'en' | 'ru'."
      },
      "checkUpdates": {
        "type": "bool",
        "default": true
      },
      "firstRunDone": {
        "type": "bool",
        "default": false
      },
      "features": "FeatureFlags"
    },
    "Settings": {
      "$doc": "Root of config.json. Missing fields take the defaults declared here; unknown fields are preserved on save.",
      "version": {
        "type": "int",
        "default": 1
      },
      "appearance": "AppearanceSettings",
      "dock": "DockSettings",
      "menuBar": "MenuBarSettings",
      "spotlight": "SpotlightSettings",
      "hotkeys": "HotkeySettings",
      "hotCorners": "HotCornerSettings",
      "taskbar": "TaskbarSettings",
      "desktop": "DesktopSettings",
      "weather": "WeatherSettings",
      "launchpad": "LaunchpadSettings",
      "general": "GeneralSettings"
    },
    "DesktopCell": {
      "x": "int",
      "y": "int"
    }
  }
}