{
  "domain": "settings",
  "enums": {
    "DockPosition": [
      "bottom",
      "left",
      "right"
    ],
    "DockMonitor": [
      "primary",
      "all"
    ],
    "PinnedKind": [
      "app",
      "folder"
    ],
    "TaskbarMode": {
      "values": [
        "hidden",
        "autoHide",
        "visible"
      ],
      "doc": "What happens to the native Windows taskbar."
    },
    "HotCornerAction": [
      "none",
      "missionControl",
      "launchpad",
      "spotlight",
      "showDesktop",
      "lockScreen",
      "sleep"
    ],
    "WallpaperFit": [
      "fill",
      "fit",
      "stretch",
      "center",
      "tile"
    ],
    "WidgetType": [
      "clock",
      "calendar",
      "weather",
      "reminders",
      "media",
      "battery",
      "notes"
    ],
    "WidgetSize": [
      "small",
      "medium",
      "large"
    ],
    "TemperatureUnit": [
      "c",
      "f"
    ]
  },
  "types": {
    "AppearanceSettings": {
      "mode": {
        "type": "ThemePreference",
        "default": "auto"
      },
      "accent": {
        "type": "string",
        "default": "system",
        "doc": "'system' or a CSS hex colour.",
        "pattern": "^(system|#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)$"
      },
      "reduceTransparency": "bool",
      "reduceMotion": "bool"
    },
    "PinnedItem": {
      "id": {
        "type": "string",
        "doc": "Stable id: 'aumid:<AUMID>' | 'exe:<lowercased full path>' | 'dir:<full path>'."
      },
      "kind": "PinnedKind",
      "target": {
        "type": "string",
        "doc": "AUMID, exe path or folder path.",
        "maxLength": 4096
      },
      "name": "string?"
    },
    "DockSettings": {
      "enabled": {
        "type": "bool",
        "default": true
      },
      "position": {
        "type": "DockPosition",
        "default": "bottom"
      },
      "iconSize": {
        "type": "int",
        "default": 56,
        "doc": "DIP, clamped 32..128.",
        "min": 32,
        "max": 128
      },
      "magnification": {
        "type": "bool",
        "default": true
      },
      "magnifiedSize": {
        "type": "int",
        "default": 88,
        "doc": "DIP, clamped to iconSize..192.",
        "min": 32,
        "max": 192
      },
      "autoHide": {
        "type": "bool",
        "default": false
      },
      "reserveSpace": {
        "type": "bool",
        "default": true,
        "doc": "Register as AppBar so maximised windows stop above the dock. Ignored when autoHide."
      },
      "showIndicators": {
        "type": "bool",
        "default": true
      },
      "bounceOnLaunch": {
        "type": "bool",
        "default": true
      },
      "monitor": {
        "type": "DockMonitor",
        "default": "primary"
      },
      "pins": {
        "type": "PinnedItem[]",
        "maxItems": 100
      }
    },
    "MenuBarSettings": {
      "enabled": {
        "type": "bool",
        "default": true
      },
      "showDate": {
        "type": "bool",
        "default": true
      },
      "showSeconds": {
        "type": "bool",
        "default": false
      },
      "use24Hour": {
        "type": "bool",
        "default": true
      },
      "showBatteryPercent": {
        "type": "bool",
        "default": true
      },
      "autoHide": {
        "type": "bool",
        "default": false
      },
      "translucent": {
        "type": "bool",
        "default": true
      },
      "allMonitors": {
        "type": "bool",
        "default": true
      }
    },
    "SpotlightSettings": {
      "hotkey": {
        "type": "string",
        "default": "Alt+Space",
        "maxLength": 64
      },
      "providers": {
        "type": "string[]",
        "default": [
          "apps",
          "calc",
          "settings",
          "commands",
          "windows",
          "files",
          "web"
        ],
        "maxItems": 16
      },
      "webSearchUrl": {
        "type": "string",
        "default": "https://duckduckgo.com/?q={query}",
        "maxLength": 512
      },
      "maxResults": {
        "type": "int",
        "default": 9,
        "min": 1,
        "max": 30
      }
    },
    "HotkeySettings": {
      "launchpad": {
        "type": "string",
        "default": "Ctrl+Alt+L",
        "maxLength": 64
      },
      "missionControl": {
        "type": "string",
        "default": "Ctrl+Alt+M",
        "maxLength": 64
      },
      "exit": {
        "type": "string",
        "default": "Ctrl+Alt+Q",
        "maxLength": 64
      },
      "toggleTaskbar": {
        "type": "string",
        "default": "Ctrl+Alt+Shift+T",
        "maxLength": 64
      }
    },
    "HotCornerSettings": {
      "enabled": {
        "type": "bool",
        "default": true
      },
      "topLeft": {
        "type": "HotCornerAction",
        "default": "missionControl"
      },
      "topRight": {
        "type": "HotCornerAction",
        "default": "none"
      },
      "bottomLeft": {
        "type": "HotCornerAction",
        "default": "none"
      },
      "bottomRight": {
        "type": "HotCornerAction",
        "default": "none"
      },
      "dwellMs": {
        "type": "int",
        "default": 150,
        "min": 50,
        "max": 2000
      }
    },
    "TaskbarSettings": {
      "mode": {
        "type": "TaskbarMode",
        "default": "visible"
      }
    },
    "DesktopShortcut": {
      "id": "string",
      "name": {
        "type": "string",
        "maxLength": 256
      },
      "target": {
        "type": "string",
        "maxLength": 4096
      },
      "x": "int",
      "y": "int",
      "monitorId": {
        "type": "string?",
        "doc": "null = primary monitor."
      }
    },
    "WidgetInstance": {
      "id": "string",
      "type": "WidgetType",
      "size": {
        "type": "WidgetSize",
        "default": "medium"
      },
      "x": {
        "type": "double",
        "min": -16384,
        "max": 16384
      },
      "y": {
        "type": "double",
        "min": -16384,
        "max": 16384
      },
      "config": {
        "type": "any",
        "doc": "Widget-specific JSON object. desktop.updateWidget REPLACES the whole object. Schemas: clock {style:'digital'|'analog', seconds:bool, timezone?:string}; calendar {weekNumbers:bool}; weather {} (uses settings.weather); reminders {list?:string}; media {}; battery {}; notes {text:string}."
      },
      "monitorId": {
        "type": "string?",
        "doc": "null = primary monitor."
      }
    },
    "DesktopSettings": {
      "enabled": {
        "type": "bool",
        "default": false,
        "doc": "Replace the desktop layer (wallpaper, shortcuts, widgets). Off until the user opts in."
      },
      "hideNativeIcons": {
        "type": "bool",
        "default": true
      },
      "wallpaperPath": {
        "type": "string?",
        "maxLength": 4096
      },
      "wallpaperFit": {
        "type": "WallpaperFit",
        "default": "fill"
      },
      "iconSize": {
        "type": "int",
        "default": 64,
        "min": 32,
        "max": 128
      },
      "gridSnap": {
        "type": "bool",
        "default": true
      },
      "shortcuts": {
        "type": "DesktopShortcut[]",
        "maxItems": 500
      },
      "widgets": {
        "type": "WidgetInstance[]",
        "maxItems": 100
      },
      "wallpapers": {
        "type": "map<string>",
        "doc": "monitorId -> wallpaper path; overrides wallpaperPath, which is the default for monitors without an entry.",
        "maxItems": 64
      },
      "showDesktopFolder": {
        "type": "bool",
        "default": true,
        "doc": "Also show the contents of the user's Desktop folder (+ This PC, Recycle Bin) as icons; otherwise only 'shortcuts'. With hideNativeIcons on, turning this off makes those items unreachable from the desktop."
      },
      "placements": {
        "type": "map<DesktopCell>",
        "doc": "Icon id -> grid cell for icons that are not in 'shortcuts' (desktop-folder items, specials).",
        "maxItems": 2000
      }
    },
    "WeatherSettings": {
      "locationName": {
        "type": "string",
        "maxLength": 256
      },
      "latitude": {
        "type": "double?",
        "min": -90,
        "max": 90
      },
      "longitude": {
        "type": "double?",
        "min": -180,
        "max": 180
      },
      "unit": {
        "type": "TemperatureUnit",
        "default": "c"
      }
    },
    "LaunchpadFolder": {
      "id": {
        "type": "string",
        "doc": "'folder:<guid>'."
      },
      "name": {
        "type": "string",
        "maxLength": 128
      },
      "appIds": {
        "type": "string[]",
        "doc": "App ids in in-folder order.",
        "maxItems": 200
      }
    },
    "LaunchpadSettings": {
      "folders": {
        "type": "LaunchpadFolder[]",
        "maxItems": 100
      },
      "order": {
        "type": "string[]",
        "doc": "Top-level grid order: app ids AND folder ids. Apps that are members of a folder or listed in 'hidden' MUST NOT appear here. Apps missing from 'order' are appended alphabetically. Ids of uninstalled apps are pruned on save, folder ids are kept.",
        "maxItems": 2000
      },
      "hidden": {
        "type": "string[]",
        "maxItems": 2000
      }
    },
    "GeneralSettings": {
      "autostart": {
        "type": "bool",
        "default": false
      },
      "language": {
        "type": "string",
        "default": "auto",
        "doc": "'auto' | 'en' | 'ru'.",
        "pattern": "^(auto|en|ru)$"
      },
      "checkUpdates": {
        "type": "bool",
        "default": true
      },
      "firstRunDone": {
        "type": "bool",
        "default": false
      },
      "features": "FeatureFlags"
    },
    "Settings": {
      "$doc": "Root of config.json. Missing fields take the defaults declared here; unknown fields are preserved on save.",
      "version": {
        "type": "int",
        "default": 1
      },
      "appearance": "AppearanceSettings",
      "dock": "DockSettings",
      "menuBar": "MenuBarSettings",
      "spotlight": "SpotlightSettings",
      "hotkeys": "HotkeySettings",
      "hotCorners": "HotCornerSettings",
      "taskbar": "TaskbarSettings",
      "desktop": "DesktopSettings",
      "weather": "WeatherSettings",
      "launchpad": "LaunchpadSettings",
      "general": "GeneralSettings"
    },
    "DesktopCell": {
      "x": "int",
      "y": "int"
    }
  }
}