{
  "domain": "apps",
  "types": {
    "AppEntry": {
      "id": {
        "type": "string",
        "doc": "'aumid:<AUMID>' when an AUMID is known, else 'exe:<lowercased full path>'."
      },
      "name": "string",
      "path": {
        "type": "string?",
        "doc": "Target exe path when known."
      },
      "aumid": "string?",
      "packaged": "bool",
      "iconUrl": "string",
      "category": "string?"
    },
    "AppList": {
      "apps": "AppEntry[]"
    },
    "AppLaunchParams": {
      "appId": "string"
    },
    "AppIdParams": {
      "appId": "string"
    }
  },
  "events": {
    "apps.changed": {
      "dir": "host",
      "payload": "AppList",
      "doc": "The installed-app catalog changed (install/uninstall).",
      "state": true,
      "initial": [
        "overlay"
      ]
    }
  },
  "calls": {
    "apps.list": {
      "params": null,
      "result": "AppList",
      "surfaces": [
        "overlay",
        "settings"
      ]
    },
    "apps.launch": {
      "params": "AppLaunchParams",
      "result": null,
      "surfaces": [
        "dock",
        "overlay"
      ],
      "doc": "Launch a catalog or running app by id (no arguments are ever accepted from the UI). Unknown ids -> notFound."
    },
    "apps.reveal": {
      "params": "AppIdParams",
      "result": null,
      "doc": "Show the app's exe/shortcut in Explorer.",
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    }
  }
}