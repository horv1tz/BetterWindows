{
  "domain": "windows",
  "enums": {
    "DockItemKind": [
      "app",
      "folder",
      "separator"
    ],
    "DockBounceKind": [
      "launch",
      "attention"
    ]
  },
  "types": {
    "WindowRef": {
      "$doc": "A top-level window. handle is the HWND as a decimal string (JS numbers cannot hold 64-bit values).",
      "handle": "string",
      "title": "string",
      "appId": "string",
      "iconUrl": "string",
      "thumbUrl": "string?",
      "minimized": "bool",
      "maximized": "bool",
      "active": "bool",
      "desktopId": "string?",
      "elevated": {
        "type": "bool",
        "doc": "The window's process runs elevated: the shell (not elevated) cannot activate/minimise/close it (UIPI). UI shows a hint."
      }
    },
    "ActiveApp": {
      "appId": "string",
      "name": "string",
      "iconUrl": "string",
      "handle": "string?",
      "title": "string?"
    },
    "ActiveAppState": {
      "app": "ActiveApp?"
    },
    "DockItem": {
      "id": {
        "type": "string",
        "doc": "Pinned id or running app id (see PinnedItem.id); separators use 'separator:N'."
      },
      "kind": "DockItemKind",
      "appId": "string?",
      "name": "string",
      "iconUrl": "string",
      "target": {
        "type": "string?",
        "doc": "Folder path for kind=folder."
      },
      "pinned": "bool",
      "running": "bool",
      "active": "bool",
      "attention": "bool",
      "badge": {
        "type": "string?",
        "doc": "Reserved: always null on Windows (no API exposes taskbar overlay badges to other processes)."
      },
      "windows": {
        "type": "WindowRef[]",
        "doc": "Windows of this app, most recently active first."
      },
      "launching": {
        "type": "bool",
        "doc": "Launch requested but no window yet. The host adds a transient item for unpinned apps and removes it on the first window or after 20 s."
      }
    },
    "DockState": {
      "items": {
        "type": "DockItem[]",
        "doc": "Pinned items in user order, then running-but-unpinned apps; folders and the trash-like tail after a separator."
      },
      "minimized": {
        "type": "WindowRef[]",
        "doc": "Minimised windows (right-hand section)."
      },
      "activeItemId": "string?"
    },
    "DockItemParams": {
      "itemId": "string"
    },
    "WindowHandleParams": {
      "handle": "string"
    },
    "DockPinParams": {
      "appId": "string",
      "index": "int?"
    },
    "DockReorderParams": {
      "itemIds": {
        "type": "string[]",
        "doc": "Full ordered list of PINNED item ids."
      }
    },
    "DockRevealState": {
      "revealed": "bool"
    },
    "DockBounce": {
      "itemId": "string",
      "kind": "DockBounceKind"
    },
    "DesktopInfo": {
      "id": "string",
      "name": "string",
      "index": "int",
      "current": "bool"
    },
    "McWindow": {
      "handle": "string",
      "title": "string",
      "appId": "string",
      "appName": "string",
      "iconUrl": "string",
      "thumbUrl": {
        "type": "string?",
        "doc": "https://app.local/dyn/thumb/<handle>?w=<px>&rev=<n>; may be absent until captured (then mc.thumbnail fires)."
      },
      "desktopId": "string?",
      "bounds": "Rect",
      "minimized": "bool",
      "active": "bool",
      "monitorId": {
        "type": "string?",
        "doc": "Monitor whose area contains the window's centre."
      }
    },
    "McSnapshot": {
      "desktops": "DesktopInfo[]",
      "desktopsSupported": "bool",
      "windows": "McWindow[]",
      "rev": {
        "type": "int",
        "doc": "Monotonic per overlay show. The UI drops a snapshot or mc.changed whose rev is lower than the last one applied."
      }
    },
    "McSnapshotParams": {
      "monitorId": {
        "type": "string?",
        "doc": "null = the overlay's monitor. Only windows whose centre lies on this monitor are returned; bounds are DIPs relative to this monitor's top-left (converted with its scale)."
      }
    },
    "McThumbnail": {
      "handle": "string",
      "thumbUrl": "string"
    },
    "McMoveParams": {
      "handle": "string",
      "desktopId": "string"
    },
    "DesktopIdParams": {
      "desktopId": "string"
    },
    "DockPinPathParams": {
      "path": {
        "type": "string",
        "doc": "Absolute path of a folder, exe or lnk to pin (the UI obtains it with system.pickPath)."
      },
      "index": "int?"
    }
  },
  "events": {
    "activeApp.changed": {
      "dir": "host",
      "payload": "ActiveAppState",
      "doc": "Foreground app (ignoring BetterWindows' own windows). Drives the menu bar app name.",
      "state": true,
      "initial": [
        "menubar",
        "overlay"
      ]
    },
    "dock.state": {
      "dir": "host",
      "payload": "DockState",
      "doc": "Full dock model; pushed on any window/pin/settings change (coalesced to >=50 ms).",
      "state": true,
      "initial": [
        "dock",
        "overlay"
      ]
    },
    "dock.reveal": {
      "dir": "host",
      "payload": "DockRevealState",
      "doc": "Auto-hide: host detected the pointer at the dock edge (true) or leaving (false)."
    },
    "dock.bounce": {
      "dir": "host",
      "payload": "DockBounce"
    },
    "mc.thumbnail": {
      "dir": "host",
      "payload": "McThumbnail",
      "doc": "A thumbnail became available after mc.snapshot."
    },
    "mc.changed": {
      "dir": "host",
      "payload": "McSnapshot",
      "doc": "Pushed to the overlay while mode=missionControl is shown whenever windows or desktops change (coalesced >= 100 ms). mc.thumbnail still fills in thumbnails."
    }
  },
  "calls": {
    "dock.activate": {
      "params": "DockItemParams",
      "result": null,
      "doc": "Launch if not running; else focus the most recent window (restore if minimised); folders open in Explorer.",
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.activateWindow": {
      "params": "WindowHandleParams",
      "result": null,
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.closeWindow": {
      "params": "WindowHandleParams",
      "result": null,
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.pin": {
      "params": "DockPinParams",
      "result": null,
      "doc": "Pin by app id (from the catalog or a running app). index = position in settings.dock.pins; folders are always appended after apps.",
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.unpin": {
      "params": "DockItemParams",
      "result": null,
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.reorder": {
      "params": "DockReorderParams",
      "result": null,
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.newWindow": {
      "params": "DockItemParams",
      "result": null,
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.quit": {
      "params": "DockItemParams",
      "result": null,
      "doc": "Close all windows of the app (WM_CLOSE). itemId may be ANY running app id, not only a visible dock item (used by the app menu).",
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.hide": {
      "params": "DockItemParams",
      "result": null,
      "doc": "Minimise all windows of the app. itemId may be ANY running app id (used by the app menu).",
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "dock.revealInExplorer": {
      "params": "DockItemParams",
      "result": null,
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    },
    "mc.snapshot": {
      "params": "McSnapshotParams",
      "result": "McSnapshot",
      "surfaces": [
        "overlay"
      ]
    },
    "mc.activateWindow": {
      "params": "WindowHandleParams",
      "result": null,
      "surfaces": [
        "overlay"
      ]
    },
    "mc.closeWindow": {
      "params": "WindowHandleParams",
      "result": null,
      "surfaces": [
        "overlay"
      ]
    },
    "mc.switchDesktop": {
      "params": "DesktopIdParams",
      "result": null,
      "surfaces": [
        "overlay"
      ]
    },
    "mc.moveWindow": {
      "params": "McMoveParams",
      "result": null,
      "surfaces": [
        "overlay"
      ]
    },
    "mc.createDesktop": {
      "params": null,
      "result": "DesktopInfo",
      "surfaces": [
        "overlay"
      ]
    },
    "mc.removeDesktop": {
      "params": "DesktopIdParams",
      "result": null,
      "surfaces": [
        "overlay"
      ]
    },
    "dock.pinPath": {
      "params": "DockPinPathParams",
      "result": null,
      "doc": "Pin a folder / exe / lnk by path (folders become kind=folder items, exe/lnk become app items with id exe:<path>).",
      "surfaces": [
        "dock",
        "overlay",
        "settings"
      ]
    }
  }
}