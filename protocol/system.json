{
  "domain": "system",
  "types": {
    "PowerParams": {
      "action": "PowerAction"
    },
    "OpenParams": {
      "target": {
        "type": "string",
        "doc": "http(s) URL or ms-settings: URI ONLY; any path or other scheme is rejected with badRequest. Files and folders are opened only by id (search.perform, desktop.open, dock.activate, apps.reveal, dock.revealInExplorer)."
      }
    },
    "ShowTaskbarParams": {
      "show": "bool"
    },
    "AboutInfo": {
      "version": "string",
      "build": "string",
      "os": "string",
      "webView2": "string"
    },
    "DiagCheck": {
      "name": "string",
      "ok": "bool",
      "detail": "string"
    },
    "DiagReport": {
      "version": "string",
      "os": "string",
      "checks": "DiagCheck[]"
    },
    "PickPathParams": {
      "kind": "PickKind",
      "title": "string?",
      "multiple": {
        "type": "bool",
        "default": false
      }
    },
    "PickPathResult": {
      "paths": {
        "type": "string[]",
        "doc": "Absolute paths; empty = cancelled."
      }
    },
    "MonitorList": {
      "monitors": "MonitorInfo[]"
    }
  },
  "calls": {
    "system.power": {
      "params": "PowerParams",
      "result": null,
      "surfaces": [
        "overlay",
        "settings"
      ]
    },
    "system.open": {
      "params": "OpenParams",
      "result": null,
      "surfaces": [
        "overlay",
        "settings"
      ]
    },
    "system.quit": {
      "params": null,
      "result": null,
      "doc": "ALWAYS restores the taskbar and desktop icons, then exits.",
      "surfaces": [
        "overlay",
        "settings"
      ]
    },
    "system.showTaskbar": {
      "params": "ShowTaskbarParams",
      "result": null,
      "doc": "Temporarily show/hide the native taskbar without changing settings.",
      "surfaces": [
        "overlay",
        "settings"
      ]
    },
    "system.about": {
      "params": null,
      "result": "AboutInfo",
      "surfaces": [
        "overlay",
        "settings"
      ]
    },
    "diag.report": {
      "params": null,
      "result": "DiagReport",
      "doc": "Runs every platform self-check (also: BetterWindows.exe --diagnose).",
      "surfaces": [
        "settings"
      ]
    },
    "system.pickPath": {
      "params": "PickPathParams",
      "result": "PickPathResult",
      "doc": "Native open dialog owned by the calling surface's window (the UI cannot obtain filesystem paths any other way: <input type=file> and drag&drop give no path). The dialog is modal to the settings window; other surfaces may not call it (BadRequest).",
      "surfaces": [
        "settings"
      ]
    },
    "system.monitors": {
      "params": null,
      "result": "MonitorList",
      "doc": "All connected monitors (for per-monitor wallpaper/widget pickers in the settings window).",
      "surfaces": [
        "settings"
      ]
    }
  },
  "enums": {
    "PickKind": {
      "values": [
        "file",
        "folder",
        "image",
        "app"
      ],
      "doc": "file = any file; folder; image = png/jpg/jpeg/bmp/webp; app = exe/lnk."
    }
  }
}